# vercel
.vercel

# typescript
*.tsbuildinfo

# Raw ASA payloads are regenerable and change on every fetch.
# Run `npm run pipeline` (or `python -m keeperiq.cli`) to recreate them.
/data/raw/asa/

# HTML scrape cache (regenerable via npm run pipeline:scrape)
/data/raw/scrape/

# Local DuckDB is regenerable from the pipeline; omit large binary from git.
/data/keeperiq.duckdb
/data/keeperiq.duckdb.wal

# R / Quarto intermediates (keep analysis-r/output/*.html as a portfolio artefact)
/analysis-r/.quarto/
/analysis-r/*_cache/
/analysis-r/*_files/
