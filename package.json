{
  "name": "mls-keeperiq",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pipeline": "PYTHONPATH=pipeline/src .venv/bin/python -m keeperiq.cli build",
    "pipeline:offline": "PYTHONPATH=pipeline/src .venv/bin/python -m keeperiq.cli build --offline",
    "pipeline:scrape": "PYTHONPATH=pipeline/src .venv/bin/python -m keeperiq.cli scrape",
    "pipeline:test": ".venv/bin/python -m pytest pipeline/tests -q",
    "pipeline:lint": ".venv/bin/ruff check pipeline/src pipeline/tests",
    "analysis:r": "Rscript analysis-r/render.R",
    "verify": "npm run pipeline:lint && npm run pipeline:test && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "next": "16.2.11",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
